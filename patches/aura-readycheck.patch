+bool CGame::GetAllReady() const
+{
+  // arranque automatico: verdadero cuando hay al menos 2 jugadores humanos y
+  // TODOS los que estan en el lobby marcaron !ready y ya bajaron el mapa. Los
+  // slots de computadora no cuentan. No existe en el Aura de upstream.
+
+  if (GetNumHumanPlayers() < 2)
+    return false;
+
+  for (auto& player : m_Players)
+  {
+    if (player->GetLeftMessageSent())
+      continue;
+
+    if (!player->GetReady())
+      return false;
+
+    // no arrancar si alguien todavia esta bajando el mapa: el arranque usa
+    // force y se saltea ese chequeo, asi que lo hacemos aca a mano
+    const uint8_t SID = GetSIDFromPID(player->GetPID());
+
+    if (SID < m_Slots.size() && m_Slots[SID].GetDownloadStatus() != 100)
+      return false;
+  }
+
+  return true;
+}
+
 string CGame::GetDescription() const
 {
   string Description = m_GameName + " : " + m_OwnerName + " : " + to_string(GetNumHumanPlayers()) + "/" + to_string(m_GameLoading || m_GameLoaded ? m_StartPlayers : m_Slots.size());
@@ -604,6 +634,36 @@ bool CGame::Update(void* fd, void* send_fd)
   if (m_GameLoaded)
     return m_Exiting;
 
+  // arranque automatico por !ready (no existe en el Aura de upstream)
+  //
+  // Cuando todos los jugadores del lobby marcaron !ready se arma una cuenta
+  // regresiva de 30 segundos; si al terminar siguen todos listos, la partida
+  // arranca sola sin que haga falta un admin. Si alguien se va, cae el lobby o
+  // alguien saca su !ready, GetAllReady() vuelve a dar falso y se cancela.
+
+  if (!m_CountDownStarted)
+  {
+    if (GetAllReady())
+    {
+      if (!m_ReadyCheckArmed)
+      {
+        m_ReadyCheckArmed     = true;
+        m_ReadyCheckStartTime = Time;
+        SendAllChat("Todos listos. La partida arranca sola en 30 segundos (el primero en entrar puede poner !start para arrancar ya)");
+      }
+      else if (Time - m_ReadyCheckStartTime >= 30)
+      {
+        SendAllChat("Todos listos: arrancando la partida");
+        StartCountDown(true);
+      }
+    }
+    else if (m_ReadyCheckArmed)
+    {
+      m_ReadyCheckArmed = false;
+      SendAllChat("Arranque automatico cancelado (ya no estan todos listos)");
+    }
+  }
+
   // refresh every 3 seconds
 
   if (!m_RefreshError && !m_CountDownStarted && m_GameState == GAME_PUBLIC && GetSlotsOpen() > 0 && Time - m_LastRefreshTime >= 3)
@@ -3435,6 +3495,86 @@ bool CGame::EventPlayerBotCommand(CGamePlayer* player, string& command, string&
 
       break;
     }
+
+    //
+    // !READY
+    // !R
+    //
+    // Cualquier jugador se marca listo. Cuando estan todos listos arranca la
+    // cuenta regresiva de 30s (ver CGame::Update). No existe en upstream.
+    //
+
+    case HashCode("ready"):
+    case HashCode("r"):
+    {
+      if (m_GameLoading || m_GameLoaded || m_CountDownStarted)
+        break;
+
+      player->SetReady(true);
+
+      // contar cuantos humanos faltan por marcarse listos
+      uint32_t Ready = 0, Humans = 0;
+
+      for (auto& p : m_Players)
+      {
+        if (p->GetLeftMessageSent())
+          continue;
+
+        ++Humans;
+
+        if (p->GetReady())
+          ++Ready;
+      }
+
+      if (Humans < 2)
+        SendAllChat("[" + User + "] esta listo. Hacen falta al menos 2 jugadores para arrancar");
+      else if (Ready < Humans)
+        SendAllChat("[" + User + "] esta listo (" + to_string(Ready) + "/" + to_string(Humans) + "). Escriban !ready cuando esten");
+
+      break;
+    }
+
+    //
+    // !NOTREADY
+    // !UNREADY
+    //
+
+    case HashCode("notready"):
+    case HashCode("unready"):
+    {
+      if (m_GameLoading || m_GameLoaded || m_CountDownStarted)
+        break;
+
+      player->SetReady(false);
+      SendAllChat("[" + User + "] ya no esta listo");
+
+      break;
+    }
+
+    //
+    // !START (para jugadores comunes)
+    // !S
+    //
+    // Si estan TODOS listos, cualquier jugador puede arrancar en el acto sin
+    // esperar los 30 segundos. Los admins ya tienen su propio !start mas arriba
+    // (que no exige que todos esten listos), asi que este caso solo hace algo
+    // para los que no son admin.
+    //
+
+    case HashCode("start"):
+    case HashCode("s"):
+    {
+      if (m_CountDownStarted)
+        break;
+
+      if (GetAllReady() && GetTicks() - m_LastPlayerLeaveTicks >= 2000)
+      {
+        SendAllChat("Todos listos: arrancando la partida");
+        StartCountDown(true);
+      }
+
+      break;
+    }
   }
 
   return true;
