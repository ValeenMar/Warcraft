# Unidad instanciada del hostbot Aura. Cada instancia N vive en
# /opt/wc3/hostbot/instances/N/ con su propio aura.cfg (renderizado por
# install/40-render-configs.sh) porque Aura lee "aura.cfg" del directorio de
# trabajo (hardcodeado en src/aura.cpp, no acepta ruta por argumento).
#
# Alta de una instancia nueva:
#   1. crear config/hostbot/instance-3.env en el repo (puertos unicos)
#   2. correr install/40-render-configs.sh
#   3. systemctl enable --now wc3-hostbot@3

[Unit]
Description=Aura hostbot de WC3, instancia %i
After=network-online.target pvpgn.service
Wants=network-online.target
# El bot reintenta la conexion al PvPGN por si cae; no encadenamos Requires=.

[Service]
Type=simple
User=wc3
Group=wc3
WorkingDirectory=/opt/wc3/hostbot/instances/%i
ExecStart=/opt/wc3/hostbot/aura++
Restart=on-failure
RestartSec=10

# --- Limites de recursos (VPS de 2 GB, varias instancias) --------------------
MemoryMax=384M
TasksMax=64

# --- Hardening ---------------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# La instancia escribe su sqlite (aura.dbs) y los mapcfgs compartidos.
#
# /opt/wc3/maps aparece aca aunque el bot solo LEE los mapas. Motivo: Aura
# llama a SFileOpenArchive sin MPQ_OPEN_READ_ONLY, asi que StormLib abre cada
# .w3x en lectura-escritura. Con ProtectSystem=strict el montaje es de solo
# lectura y la apertura falla, dejando el mapa sin map_crc ("invalid map_crc
# detected"). Descubierto en el servidor real el 2026-08-09.
#
# install/20-build-hostbot.sh parchea Aura para pasar el flag correcto; una vez
# recompilado con ese parche, /opt/wc3/maps puede volver a ReadOnlyPaths.
ReadWritePaths=/opt/wc3/hostbot/instances/%i /opt/wc3/hostbot/mapcfgs /opt/wc3/maps
# MPQ del juego: solo lectura (el parche de arriba hace que alcance)
ReadOnlyPaths=/opt/wc3/mpq

[Install]
WantedBy=multi-user.target
