# Instancia 8: DBZ Tribute Ultra
# Generado por scripts/make-instances.py. Pisa las variables de .env al
# renderizar el aura.cfg de /opt/wc3/hostbot/instances/8/.
#
# La cuenta hostbot8 hay que crearla a mano en PvPGN desde el cliente del
# juego: Battle.net no admite la misma cuenta conectada dos veces. La
# contrasena sale de WC3_BOT_PASSWORD en .env, o sea que es la misma para
# todos los bots.
WC3_BOT_USERNAME=hostbot8
WC3_BOT_HOSTPORT=6120
WC3_BOT_RECONNECTPORT=6140
WC3_BOT_VIRTUALHOST="DBZ"
WC3_BOT_DEFAULTMAP=dbz-tribute
WC3_BOT_MAXGAMES=4
WC3_BOT_AUTOHOSTNAME="DBZ Tribute Ultra"
