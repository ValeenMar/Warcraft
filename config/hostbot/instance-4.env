# Instancia 4: DotA Allstars 6.83d
# Generado por scripts/make-instances.py. Pisa las variables de .env al
# renderizar el aura.cfg de /opt/wc3/hostbot/instances/4/.
#
# La cuenta hostbot4 hay que crearla a mano en PvPGN desde el cliente del
# juego: Battle.net no admite la misma cuenta conectada dos veces. La
# contrasena sale de WC3_BOT_PASSWORD en .env, o sea que es la misma para
# todos los bots.
WC3_BOT_USERNAME=hostbot4
WC3_BOT_HOSTPORT=6116
WC3_BOT_RECONNECTPORT=6136
WC3_BOT_VIRTUALHOST="DotA"
WC3_BOT_DEFAULTMAP=dota
WC3_BOT_MAXGAMES=4
WC3_BOT_AUTOHOSTNAME="DotA Allstars 6.83d"
