# Instancia 2: Anime Fight Beta 1.39b
# Generado por scripts/make-instances.py. Pisa las variables de .env al
# renderizar el aura.cfg de /opt/wc3/hostbot/instances/2/.
#
# La cuenta hostbot2 hay que crearla a mano en PvPGN desde el cliente del
# juego: Battle.net no admite la misma cuenta conectada dos veces. La
# contrasena sale de WC3_BOT_PASSWORD en .env, o sea que es la misma para
# todos los bots.
WC3_BOT_USERNAME=hostbot2
WC3_BOT_HOSTPORT=6114
WC3_BOT_RECONNECTPORT=6134
WC3_BOT_VIRTUALHOST="AnimeFight"
WC3_BOT_DEFAULTMAP=anime-fight
WC3_BOT_MAXGAMES=4
WC3_BOT_AUTOHOSTNAME="Anime Fight Beta 1.39b"
