# Instancia 9: Fight of Characters 9.6G03 ES
# Generado por scripts/make-instances.py. Pisa las variables de .env al
# renderizar el aura.cfg de /opt/wc3/hostbot/instances/9/.
#
# La cuenta hostbot9 hay que crearla a mano en PvPGN desde el cliente del
# juego: Battle.net no admite la misma cuenta conectada dos veces. La
# contrasena sale de WC3_BOT_PASSWORD en .env, o sea que es la misma para
# todos los bots.
WC3_BOT_USERNAME=hostbot9
WC3_BOT_HOSTPORT=6121
WC3_BOT_RECONNECTPORT=6141
WC3_BOT_VIRTUALHOST="FOC"
WC3_BOT_DEFAULTMAP=foc-96g03-es
WC3_BOT_MAXGAMES=4
WC3_BOT_AUTOHOSTNAME="FOC 9.6G03 ES - PRUEBA"
