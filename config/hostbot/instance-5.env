# Instancia 5: Marvel Tower Defense 1.3
# Generado por scripts/make-instances.py. Pisa las variables de .env al
# renderizar el aura.cfg de /opt/wc3/hostbot/instances/5/.
#
# La cuenta hostbot5 hay que crearla a mano en PvPGN desde el cliente del
# juego: Battle.net no admite la misma cuenta conectada dos veces. La
# contrasena sale de WC3_BOT_PASSWORD en .env, o sea que es la misma para
# todos los bots.
WC3_BOT_USERNAME=hostbot5
WC3_BOT_HOSTPORT=6117
WC3_BOT_RECONNECTPORT=6137
WC3_BOT_VIRTUALHOST="MarvelTD"
WC3_BOT_DEFAULTMAP=marvel-td
WC3_BOT_MAXGAMES=4
WC3_BOT_AUTOHOSTNAME="Marvel Tower Defense 1.3"
