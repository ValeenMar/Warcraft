# Instancia 1: AoS / hero arenas
# Estas variables pisan (o completan) a las de .env al renderizar aura.cfg
# de /opt/wc3/hostbot/instances/1/. Sintaxis: KEY=valor, una por linea.
WC3_BOT_HOSTPORT=6113
WC3_BOT_RECONNECTPORT=6133
# Maximo 15 caracteres CONTANDO el codigo de color (|cFF4080C0 son 10)
WC3_BOT_VIRTUALHOST="|cFF4080C0AoS"
WC3_BOT_DEFAULTMAP=dota
WC3_BOT_AUTOHOSTNAME="DotA Allstars 6.83d"
WC3_BOT_MAXGAMES=4
WC3_BOT_CHANNEL=AoS
