# Perfil conservador para VPS de 1 GB. PvPGN guarda una base pequeña y usa
# pocas conexiones; los defaults de MySQL 8 reservan memoria innecesaria.
[mysqld]
performance_schema=OFF
innodb_buffer_pool_size=64M
innodb_log_buffer_size=8M
key_buffer_size=8M
max_connections=32
table_open_cache=256
tmp_table_size=16M
max_heap_table_size=16M
